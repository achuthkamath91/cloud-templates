{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "healthcare-crm-web",
  "compatibility_date": "2026-11-01",
  // Static SPA served by Cloudflare. The API is called browser -> API Gateway directly,
  // so PHI never transits Cloudflare (see docs/security.md).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
